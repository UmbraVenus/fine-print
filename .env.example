# Local: a libSQL file. Production: your Turso URL (libsql://...).
DATABASE_URL=file:./local.db
# Production only: the Turso auth token.
DATABASE_AUTH_TOKEN=
# Server-side only. Without it, seeded checks still work and Re-check shows "unavailable".
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
